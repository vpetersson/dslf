# Build artifacts
/target/

# Node dependencies and generated static output.
#
# Neither is copied by any Dockerfile. The static stage runs
# `bun install --frozen-lockfile` and `bun run build` itself, so it creates both
# inside the image, pinned to bun.lock rather than to whatever happens to be on
# the machine doing the build. Sending them anyway cost ~171 MB of upload on
# every build for files the build never reads.
node_modules/
/dist/
**/*.rs.bk
*.pdb

# Coverage reports
/coverage/
*.profraw
tarpaulin-report.html

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Environment files
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*~

# Backup files
*.bak
*.backup

# Test files
test-*.csv
*-test.csv

# Git
.git/
.gitignore

# Documentation
README.md

# Website (published to GitHub Pages, never part of an image)
# Includes CNAME once a custom domain is configured: that file belongs to the
# Pages deploy, not to the container.
site/

# Docker
Dockerfile
.dockerignore

# Scripts
scripts/